{
  "version": 1,
  "sdk_version": "0.24.0",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "rohit-sen-portfolio-mcp",
      "version": "0.1.0",
      "title": "Rohit Sen Portfolio MCP"
    },
    "tools": [
      {
        "name": "whoami",
        "title": "Who is Rohit Sen",
        "description": "Return Rohit Sen's identity: name, role, tagline, location, focus, and status.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "get_about",
        "title": "Get about section",
        "description": "Return the About section: bio paragraphs and top-line identity for Rohit Sen.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_skills",
        "title": "List skills",
        "description": "List Rohit Sen's technical skills, optionally filtered by category (frontend, backend, security, cloud, other, or all).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "category": {
              "type": "string",
              "enum": [
                "frontend",
